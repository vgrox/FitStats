# Strava application credentials from https://www.strava.com/settings/api
# Never commit the filled-in .env file.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# This is the current Strava API v3 base URL. Leave it unchanged unless Strava
# instructs you to move to a new API hostname.
STRAVA_API_BASE_URL=https://www.strava.com/api/v3

# OAuth callback for local development. Set the same host (without protocol/path)
# as Authorization Callback Domain in Strava's app settings.
STRAVA_REDIRECT_URI=http://127.0.0.1:8787/oauth/strava/callback

# Exactly 64 hexadecimal characters (32 random bytes). This encrypts the token
# ciphertext stored in SQLite. Keep it safe: changing it makes existing tokens unreadable.
TOKEN_ENCRYPTION_KEY=

# A separate random value you choose for Strava webhook subscription validation.
STRAVA_WEBHOOK_VERIFY_TOKEN=

# Set only while configuring webhooks. It must be a public HTTPS URL ending in
# /webhooks/strava, for example a temporary Cloudflare Tunnel URL.
STRAVA_WEBHOOK_CALLBACK_URL=

# Local service and database settings.
FITSTATS_PORT=8787
FITSTATS_HOST=127.0.0.1
FITSTATS_DB_PATH=data/fitstats.db

# Incremental recovery queries activities whose start date is inside this
# overlapping window. Raise temporarily for a wider missed-webhook recovery.
STRAVA_SYNC_LOOKBACK_DAYS=30
